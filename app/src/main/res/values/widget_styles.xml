<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="WidgetContentColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="WidgetLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="WidgetContentSlot">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="WidgetRefreshAction">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:src">@drawable/ic_ui_refresh</item>
        <item name="android:tint">@color/widget_secondary</item>
    </style>
</resources>
